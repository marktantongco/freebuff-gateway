# ─────────────────────────────────────────────────────────────
# Freebuff Gateway — Environment Variables
# Copy this to .env and fill in your values
# ─────────────────────────────────────────────────────────────

# ─── Core ───────────────────────────────────────────────────
ADMIN_PASSWORD=changeme
GATEWAY_PORT=30080
LOG_LEVEL=info

# ─── Session ────────────────────────────────────────────────
SESSION_WAIT_ON_FULL=false
SESSION_CREATE_MAX_PARALLEL_GLOBAL=128
SESSION_CREATE_MAX_PARALLEL_PER_KEY=32
SESSION_CREATE_MAX_PARALLEL_PER_MODEL=32
SESSION_CREATE_MAX_PARALLEL_PER_GROUP=96

# ─── Transport ──────────────────────────────────────────────
TRANSPORT_REQUEST_REUSE=false

# ─── Rate Limiting ──────────────────────────────────────────
RATE_LIMIT_RPS=200
RATE_LIMIT_BURST=400

# ─── CORS ───────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=*

# ─── Proxy Healthcheck ──────────────────────────────────────
PROXY_HEALTHCHECK_ENABLED=true
PROXY_HEALTHCHECK_INTERVAL=1m
PROXY_HEALTHCHECK_TIMEOUT=10s
PROXY_HEALTHCHECK_CONCURRENCY=5
PROXY_HEALTHCHECK_URL=

# ─── Alerting — Webhook ─────────────────────────────────────
ALERT_WEBHOOK_URL=

# ─── Alerting — Slack ───────────────────────────────────────
ALERT_SLACK_URL=

# ─── Alerting — Telegram ────────────────────────────────────
ALERT_TELEGRAM_TOKEN=
ALERT_TELEGRAM_CHAT_ID=

# ─── Alerting — Discord ─────────────────────────────────────
ALERT_DISCORD_URL=

# ─── Alerting — Email (SMTP) ────────────────────────────────
ALERT_EMAIL_SMTP=
ALERT_EMAIL_TO=
ALERT_EMAIL_CC=
ALERT_EMAIL_BCC=
ALERT_EMAIL_FROM=alerts@freebuff-gateway
ALERT_EMAIL_USERNAME=
ALERT_EMAIL_PASSWORD=

# ─── Alerting — PagerDuty ──────────────────────────────────
ALERT_PAGERDUTY_KEY=

# ─── Monitoring (docker compose --profile full) ─────────────
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# ─── Git (for Docker build args) ───────────────────────────
GIT_COMMIT=dev
BUILD_TIME=
