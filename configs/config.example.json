{
  "listen_addr": ":30080",
  "admin_password": "CHANGE_ME_IN_PRODUCTION",
  "db_path": "./data/gateway.db",

  "session": {
    "wait_on_full": false,
    "create_limits": {
      "max_parallel_global": 128,
      "max_parallel_per_key": 32,
      "max_parallel_per_model": 32,
      "max_parallel_per_group": 96
    }
  },

  "transport": {
    "timeout": "60s",
    "request_reuse": false,
    "body_preview_bytes": 8192
  },

  "proxy_pool": {
    "enabled": false,
    "primary_url": "",
    "health_check": {
      "enabled": true,
      "url": "http://ip-api.com/json/?fields=status,message,country,regionName,city,query",
      "interval": "1m",
      "timeout": "10s",
      "concurrency": 5
    }
  },

  "stealth": {
    "enabled": false,
    "tls_fingerprint": "chrome",
    "header_randomization": true,
    "proxy_rotation": true
  },

  "rate_limit": {
    "enabled": true,
    "requests_per_minute": 60
  },

  "logging": {
    "level": "info",
    "file": "",
    "redact_tokens": true
  },

  "health_check": {
    "enabled": true,
    "interval": "30s"
  },

  "models": {
    "aliases": {
      "deepseek-v4-pro": "deepseek/deepseek-v4-pro",
      "deepseek-v4-flash": "deepseek/deepseek-v4-flash",
      "mimo-v2.5": "mimo/mimo-v2.5",
      "kimi-k2.6": "moonshotai/kimi-k2.6",
      "minimax-m2.7": "minimax/minimax-m2.7",
      "gemini-pro": "google/gemini-3.1-pro-preview"
    },
    "allowlist": ["*"]
  }
}
